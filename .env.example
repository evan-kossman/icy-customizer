# ---------------------------------------------------------------------------
# Shopify — from the custom app in the Icy Shopify admin
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=              # Client ID of the custom app
SHOPIFY_API_SECRET=           # Client secret; also verifies App Proxy + webhooks
SHOPIFY_STORE_DOMAIN=wearicy.myshopify.com
SHOPIFY_APP_URL=https://icy-customizer.vercel.app
SHOPIFY_APP_PROXY_PREFIX=/apps/icy-customizer
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=       # Optional; defaults to SHOPIFY_API_SECRET

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=                 # Postgres connection string (Neon / Supabase / Vercel Postgres)
ENCRYPTION_KEY=               # >= 32 random chars; encrypts stored Shopify tokens

# ---------------------------------------------------------------------------
# Object storage — S3 compatible (Cloudflare R2 recommended)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=icy-customizer
STORAGE_PUBLIC_BASE_URL=      # Public CDN base for mockups/stickers/previews only.
                              # Production artwork is NEVER served from here.

# ---------------------------------------------------------------------------
# Feature providers (optional — features report unavailable without them)
# ---------------------------------------------------------------------------
BACKGROUND_REMOVAL_PROVIDER=removebg   # removebg | replicate | none
BACKGROUND_REMOVAL_API_KEY=

AI_PROVIDER=openai                     # openai | replicate | none
AI_API_KEY=
AI_CREDITS_PER_CUSTOMER=5

DESIGN_SESSION_TTL_HOURS=72
