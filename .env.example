# ---------------------------------------------------------------------------
# Shopify — from the Partner Dashboard app
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=              # Client ID
SHOPIFY_API_SECRET=           # Client secret; also verifies App Proxy + webhooks
SHOPIFY_STORE_DOMAIN=wearicy.myshopify.com
SHOPIFY_APP_URL=https://wearicy-customizer.vercel.app
SHOPIFY_APP_PROXY_PREFIX=/apps/icy-customizer
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=       # Optional; defaults to SHOPIFY_API_SECRET

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=                 # Vercel Postgres connection string
ENCRYPTION_KEY=               # >= 32 random chars; encrypts stored Shopify tokens
                              # Never change after install — stored tokens become
                              # undecryptable.

# ---------------------------------------------------------------------------
# Object storage — Vercel Blob
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=        # From Vercel Storage > your Blob store > .env.local

# ---------------------------------------------------------------------------
# Feature providers (optional — features report unavailable without them)
# ---------------------------------------------------------------------------
BACKGROUND_REMOVAL_PROVIDER=none   # removebg | replicate | none
BACKGROUND_REMOVAL_API_KEY=

AI_PROVIDER=none                   # openai | replicate | none
AI_API_KEY=
AI_CREDITS_PER_CUSTOMER=5

DESIGN_SESSION_TTL_HOURS=72
